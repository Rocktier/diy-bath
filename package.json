{
  "name": "diy-bath",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "description": "定制浴室柜 2D 草图生成器",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "lint:workflows": "node scripts/lint-workflows.mjs",
    "check:version": "node scripts/check-version.mjs",
    "verify": "npm run check:version && npm run lint:workflows && npm test && npm run build && npm run check:bundle",
    "check:bundle": "node scripts/check-bundle.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.1",
    "idb-keyval": "6.3.0",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.1",
    "@vitest/coverage-v8": "3.2.7",
    "vite": "6.4.3",
    "vitest": "3.2.7"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
